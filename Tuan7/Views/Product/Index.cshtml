@model IEnumerable<Tuan7.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<h1>Danh sách sản phẩm</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới sản phẩm</a>
</p>
<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Image)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.SalePrice)</th>
            <th>@Html.DisplayNameFor(model => model.CategoryId)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td style="width: 100px; text-align: center;">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="~/products/@item.Image" alt="@item.Name" class="img-thumbnail" style="max-height: 80px;" onerror="this.src='https://placehold.co/80x80?text=No+Image';" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </td>
            <td><strong>@item.Name</strong></td>
            <td>@item.Price.ToString("N0") đ</td>
            <td class="text-danger fw-bold">@item.SalePrice.ToString("N0") đ</td>
            <td>
                @(categories.ContainsKey(item.CategoryId) ? categories[item.CategoryId] : "Khác")
            </td>
            <td style="max-width: 250px;">@item.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
