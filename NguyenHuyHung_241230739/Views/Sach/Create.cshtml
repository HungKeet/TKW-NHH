@model NguyenHuyHung_241230739.Models.Sach

<div class="section-head" style="margin-bottom: 20px;">
    <h3>NGUYỄN HUY HÙNG - THÊM SÁCH MỚI</h3>
</div>

<div style="max-width: 450px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: red; margin-bottom: 15px;"></div>

        <div style="margin-bottom: 12px;">
            <label asp-for="MaTl" style="display: block; margin-bottom: 4px; font-weight: 500;"></label>
            <select asp-for="MaTl" asp-items="ViewBag.MaTl" style="width: 100%; padding: 6px; box-sizing: border-box; border: 1px solid #ccc;"></select>
            <span asp-validation-for="MaTl" style="color: red; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="TenSach" style="display: block; margin-bottom: 4px; font-weight: 500;"></label>
            <input asp-for="TenSach" style="width: 100%; padding: 6px; box-sizing: border-box; border: 1px solid #ccc;" />
            <span asp-validation-for="TenSach" style="color: red; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Gia" style="display: block; margin-bottom: 4px; font-weight: 500;"></label>
            <input asp-for="Gia" type="number" step="any" style="width: 100%; padding: 6px; box-sizing: border-box; border: 1px solid #ccc;" />
            <span asp-validation-for="Gia" style="color: red; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Anh" style="display: block; margin-bottom: 4px; font-weight: 500;"></label>
            <input asp-for="Anh" style="width: 100%; padding: 6px; box-sizing: border-box; border: 1px solid #ccc;" />
            <span asp-validation-for="Anh" style="color: red; font-size: 13px;"></span>
        </div>

        <div style="margin-top: 15px;">
            <button type="submit" class="btn-buy" style="background-color: #0b5e86; color: #fff; padding: 7px 18px; border: none; cursor: pointer; border-radius: 3px;">Create</button>
            <a asp-controller="Home" asp-action="Index" style="margin-left: 15px; color: #555; text-decoration: none;">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
