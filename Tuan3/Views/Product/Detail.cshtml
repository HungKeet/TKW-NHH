@model Tuan3.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="py-3">
    <h3 class="fw-bold mb-4">Chi tiết sản phẩm</h3>
    
    @if (Model != null)
    {
        <div class="row">
            <div class="col-md-5 mb-4 text-center">
                <div class="border p-2 rounded shadow-sm bg-white">
                    <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded" style="max-height: 420px; object-fit: contain;" />
                </div>
            </div>
            
            <div class="col-md-7">
                <h4 class="fw-bold text-dark mb-3">Sản phẩm: @Model.Name</h4>
                
                <p class="fs-5 mb-3">
                    <span class="text-muted">Giá gốc: <del>@Model.Price.ToString("N0")</del></span>
                    <span class="ms-3 fw-bold text-danger">Giá mới: @Model.SalePrice.ToString("N0")</span>
                </p>
                
                <div class="mb-3">
                    <h5 class="fw-bold mb-1">Mô Tả:</h5>
                    <p class="text-muted" style="line-height: 1.6;">
                        @Model.Description
                    </p>
                </div>
                
                <p class="mb-2 fs-5">
                    <strong>Trạng thái:</strong> 
                    <span class="badge @(Model.Status ? "bg-success" : "bg-secondary")">
                        @(Model.Status ? "Còn hàng" : "Hết hàng")
                    </span>
                </p>
                
                <p class="mb-4 text-muted">
                    <strong>Ngày đăng:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy hh:mm:ss tt")
                </p>
                
                <div>
                    <a href="/san-pham" class="btn btn-danger px-4 py-2">
                        Về danh sách
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Không tìm thấy thông tin sản phẩm.</div>
        <a href="/san-pham" class="btn btn-danger">Về danh sách</a>
    }
</div>
