@model Tuan9.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

@if (Model.Banners.Any())
{
    <div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                var banner = Model.Banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="p-5 text-white bg-dark rounded-0 d-flex align-items-center justify-content-center text-center" style="min-height: 380px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                        <div class="container py-4">
                            <span class="badge bg-warning text-dark px-3 py-2 mb-3 fw-bold text-uppercase">Khuyến mãi đặc biệt</span>
                            <h1 class="display-4 fw-bold">@banner.Name</h1>
                            <p class="lead col-lg-8 mx-auto text-light">@banner.Description</p>
                            <a href="#products-section" class="btn btn-warning btn-lg fw-bold px-4 mt-2">
                                <i class="fas fa-shopping-bag me-2"></i>Mua ngay hôm nay
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Tiếp</span>
        </button>
    </div>
}

<div class="container">
    <section id="categories-section" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-th-large text-primary me-2"></i>Danh mục nổi bật</h3>
                <p class="text-muted mb-0">Khám phá các bộ sưu tập theo ngành hàng</p>
            </div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Quản lý danh mục <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                        <div class="mb-2">
                            <i class="fas fa-folder-open fs-1 text-primary"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@cat.Name</h6>
                        <small class="text-muted">@cat.Description</small>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="products-section" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-fire text-danger me-2"></i>Sản phẩm mới nhất</h3>
                <p class="text-muted mb-0">Các mẫu sản phẩm chất lượng cao vừa cập bến kho</p>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Quản lý sản phẩm <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var prod in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 product-card">
                        <div class="bg-light text-center py-4 position-relative border-bottom">
                            <i class="fas fa-box fs-1 text-secondary"></i>
                            @if (prod.SalePrice > 0 && prod.SalePrice < prod.Price)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger">
                                    -@(((prod.Price - prod.SalePrice) / prod.Price * 100).ToString("N0"))%
                                </span>
                            }
                        </div>
                        <div class="card-body d-flex flex-direction-column flex-column">
                            <div class="small text-muted mb-1">@(prod.Category?.Name ?? "Sản phẩm")</div>
                            <h6 class="card-title fw-bold text-dark mb-2">@prod.Name</h6>
                            <p class="card-text small text-muted flex-grow-1">@(string.IsNullOrEmpty(prod.Description) ? "Sản phẩm chất lượng cao" : prod.Description)</p>
                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (prod.SalePrice > 0 && prod.SalePrice < prod.Price)
                                    {
                                        <div class="fw-bold text-danger fs-6">@prod.SalePrice.ToString("N0") đ</div>
                                        <small class="text-muted text-decoration-line-through">@prod.Price.ToString("N0") đ</small>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-primary fs-6">@prod.Price.ToString("N0") đ</div>
                                    }
                                </div>
                                <button class="btn btn-outline-primary btn-sm rounded-circle" title="Thêm vào giỏ">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section id="blogs-section" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-newspaper text-info me-2"></i>Tin tức & Bài viết</h3>
                <p class="text-muted mb-0">Cập nhật tin tức và xu hướng phong cách mới</p>
            </div>
            <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Quản lý bài viết <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var blog in Model.Blogs)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="bg-light text-center py-4 border-bottom">
                            <i class="fas fa-file-alt fs-2 text-info"></i>
                        </div>
                        <div class="card-body">
                            <div class="small text-muted mb-1"><i class="far fa-calendar-alt me-1"></i>@blog.CreatedDate.ToString("dd/MM/yyyy")</div>
                            <h6 class="card-title fw-bold text-dark">@blog.Name</h6>
                            <p class="card-text small text-secondary">@blog.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
