@model Tuan9.Models.Blog

@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-info card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title fs-5 m-0 text-dark">
                    <i class="fas fa-info-circle me-2 text-info"></i>Chi tiết bài viết #@Model.Id
                </h3>
                <span class="badge @(Model.Status == 1 ? "bg-success" : "bg-danger")">
                    @(Model.Status == 1 ? "Xuất bản" : "Bản nháp")
                </span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Mã bài viết:</dt>
                    <dd class="col-sm-9 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-3 text-muted">Tiêu đề:</dt>
                    <dd class="col-sm-9 fw-semibold fs-5 text-dark">@Model.Name</dd>

                    <dt class="col-sm-3 text-muted">Hình ảnh:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Image) ? "Chưa có hình ảnh" : Model.Image)</dd>

                    <dt class="col-sm-3 text-muted">Ngày đăng:</dt>
                    <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-3 text-muted">Nội dung tóm tắt:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "Không có nội dung" : Model.Description)</dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white me-1">
                        <i class="fas fa-edit me-1"></i>Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Xóa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
