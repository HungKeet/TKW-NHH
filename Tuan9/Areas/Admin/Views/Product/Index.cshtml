@model IEnumerable<Tuan9.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fs-5 m-0 text-dark">
            <i class="fas fa-box-open me-2 text-primary"></i>Danh sách sản phẩm
        </h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus-circle me-1"></i>Thêm sản phẩm mới
        </a>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Tìm theo tên sản phẩm..." />
            </div>
            <div class="col-auto">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select form-select-sm">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary btn-sm">
                    <i class="fas fa-filter me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.CategoryId != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
                        <i class="fas fa-sync-alt me-1"></i>Đặt lại
                    </a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">Mã</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá niêm yết</th>
                        <th>Giá KM</th>
                        <th>Hình ảnh</th>
                        <th style="width: 100px;">Trạng thái</th>
                        <th style="width: 110px;">Ngày tạo</th>
                        <th style="width: 150px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Không tìm thấy sản phẩm nào</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Category?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td class="text-primary fw-bold">@item.Price.ToString("N0") đ</td>
                                <td class="text-danger fw-bold">
                                    @(item.SalePrice > 0 ? item.SalePrice.ToString("N0") + " đ" : "-")
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="fas fa-image me-1"></i>@item.Image
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Kinh doanh</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Tạm dừng</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
