@model Tuan9.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card card-info card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title fs-5 m-0 text-dark">
                    <i class="fas fa-info-circle me-2 text-info"></i>Chi tiết sản phẩm #@Model.Id
                </h3>
                <span class="badge @(Model.Status == 1 ? "bg-success" : "bg-danger")">
                    @(Model.Status == 1 ? "Kinh doanh" : "Tạm dừng")
                </span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Mã sản phẩm:</dt>
                    <dd class="col-sm-9 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-3 text-muted">Tên sản phẩm:</dt>
                    <dd class="col-sm-9 fw-semibold fs-5 text-dark">@Model.Name</dd>

                    <dt class="col-sm-3 text-muted">Danh mục:</dt>
                    <dd class="col-sm-9"><span class="badge bg-secondary">@(Model.Category?.Name ?? "Chưa phân loại")</span></dd>

                    <dt class="col-sm-3 text-muted">Giá niêm yết:</dt>
                    <dd class="col-sm-9 text-primary fw-bold">@Model.Price.ToString("N0") đ</dd>

                    <dt class="col-sm-3 text-muted">Giá khuyến mãi:</dt>
                    <dd class="col-sm-9 text-danger fw-bold">@(Model.SalePrice > 0 ? Model.SalePrice.ToString("N0") + " đ" : "Không có")</dd>

                    <dt class="col-sm-3 text-muted">Hình ảnh:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Image) ? "Chưa có hình ảnh" : Model.Image)</dd>

                    <dt class="col-sm-3 text-muted">Ngày tạo:</dt>
                    <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-3 text-muted">Mô tả chi tiết:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white me-1">
                        <i class="fas fa-edit me-1"></i>Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Xóa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
