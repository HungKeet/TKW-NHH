@model Tuan9.Models.Banner

@{
    ViewData["Title"] = "Xác nhận xóa banner";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title fs-5 m-0 text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa banner
                </h3>
            </div>
            <div class="card-body">
                <p class="text-danger fw-semibold">Bạn có chắc chắn muốn xóa banner này không?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Mã banner:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Tên banner:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Thứ tự ưu tiên:</dt>
                    <dd class="col-sm-8">@Model.Prioty</dd>

                    <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-8">@(Model.Status == 1 ? "Hoạt động" : "Tạm ẩn")</dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Hủy bỏ
                </a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
