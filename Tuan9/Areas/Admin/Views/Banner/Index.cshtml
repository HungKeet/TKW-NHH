@model IEnumerable<Tuan9.Models.Banner>

@{
    ViewData["Title"] = "Quản lý banner";
}

<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title fs-5 m-0 text-dark">
            <i class="fas fa-images me-2 text-primary"></i>Danh sách banner quảng cáo
        </h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus-circle me-1"></i>Thêm banner mới
        </a>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Tìm kiếm banner..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary btn-sm">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
                        <i class="fas fa-sync-alt me-1"></i>Đặt lại
                    </a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">Mã</th>
                        <th>Tên banner</th>
                        <th style="width: 100px;">Thứ tự</th>
                        <th>Hình ảnh</th>
                        <th>Mô tả</th>
                        <th style="width: 110px;">Trạng thái</th>
                        <th style="width: 150px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không tìm thấy banner nào</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>
                                <td class="text-center"><span class="badge bg-secondary">@item.Prioty</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="fas fa-image me-1"></i>@item.Image
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)</td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Ẩn</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
