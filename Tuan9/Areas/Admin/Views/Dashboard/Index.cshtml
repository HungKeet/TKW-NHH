@{
    ViewData["Title"] = "Bảng điều khiển";
    var recentProducts = ViewBag.RecentProducts as List<Tuan9.Models.Product> ?? new List<Tuan9.Models.Product>();
    var recentCategories = ViewBag.RecentCategories as List<Tuan9.Models.Category> ?? new List<Tuan9.Models.Category>();
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@ViewBag.ProductCount</h3>
                <p>Tổng sản phẩm</p>
            </div>
            <div class="icon">
                <i class="fas fa-box-open"></i>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="fas fa-arrow-circle-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@ViewBag.CategoryCount</h3>
                <p>Danh mục ngành hàng</p>
            </div>
            <div class="icon">
                <i class="fas fa-folder-open"></i>
            </div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="fas fa-arrow-circle-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning text-dark">
            <div class="inner">
                <h3 class="text-dark">@ViewBag.BlogCount</h3>
                <p class="text-dark">Bài viết & Tin tức</p>
            </div>
            <div class="icon">
                <i class="fas fa-newspaper"></i>
            </div>
            <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="small-box-footer text-dark">
                Xem chi tiết <i class="fas fa-arrow-circle-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@ViewBag.BannerCount</h3>
                <p>Banner quảng cáo</p>
            </div>
            <div class="icon">
                <i class="fas fa-images"></i>
            </div>
            <a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="fas fa-arrow-circle-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark"><i class="fas fa-box me-2 text-primary"></i>Sản phẩm mới nhất</span>
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Thêm sản phẩm
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá bán</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentProducts.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted">Chưa có sản phẩm nào</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in recentProducts)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td><span class="badge bg-secondary">@(item.Category?.Name ?? "N/A")</span></td>
                                        <td class="text-danger fw-bold">@item.Price.ToString("N0") đ</td>
                                        <td>
                                            @if (item.Status == 1)
                                            {
                                                <span class="badge bg-success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Ẩn</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-end">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-link btn-sm text-decoration-none">
                    Xem tất cả sản phẩm <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-dark"><i class="fas fa-folder me-2 text-success"></i>Danh mục ngành hàng</span>
                <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-success btn-sm">
                    <i class="fas fa-plus me-1"></i>Thêm mới
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (!recentCategories.Any())
                    {
                        <li class="list-group-item text-center text-muted py-3">Chưa có danh mục nào</li>
                    }
                    else
                    {
                        @foreach (var cat in recentCategories)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <span class="fw-semibold">@cat.Name</span>
                                    <div class="small text-muted">@cat.CreatedDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <span class="badge bg-primary rounded-pill">@(cat.Products?.Count ?? 0) sp</span>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="card-footer bg-white text-end">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-link btn-sm text-decoration-none">
                    Quản lý danh mục <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
