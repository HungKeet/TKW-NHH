@model Tuan8.Models.DataModels.Book

@{
    ViewData["Title"] = "Chỉnh sửa Sách";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Chỉnh sửa thông tin Sách</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BookId" class="form-label fw-bold">Mã sách</label>
                        <input asp-for="BookId" class="form-control" readonly />
                        <span asp-validation-for="BookId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold">Tên sách (*)</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-bold">Tác giả</label>
                        <input asp-for="Author" class="form-control" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Release" class="form-label fw-bold">Năm xuất bản</label>
                        <input asp-for="Release" type="number" class="form-control" />
                        <span asp-validation-for="Release" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold">Loại sách</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">-- Chọn loại sách --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PublisherId" class="form-label fw-bold">Nhà xuất bản</label>
                        <select asp-for="PublisherId" class="form-select" asp-items="ViewBag.PublisherId">
                            <option value="">-- Chọn nhà xuất bản --</option>
                        </select>
                        <span asp-validation-for="PublisherId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh đại diện</label>
                    @if (!string.IsNullOrEmpty(Model.Picture))
                    {
                        <div class="mb-2">
                            <img src="~/images/@Model.Picture" alt="@Model.Title" class="img-thumbnail" style="max-height: 120px;" onerror="this.onerror=null;this.src='/images/book1.jpg';" />
                        </div>
                    }
                    <input type="file" name="fileImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Để trống nếu không muốn thay đổi ảnh bìa.</small>
                    <input type="hidden" asp-for="Picture" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả tóm tắt</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning px-4">Cập nhật thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
