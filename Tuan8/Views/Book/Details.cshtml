@model Tuan8.Models.DataModels.Book

@{
    ViewData["Title"] = "Chi tiết Sách - " + Model.Title;
}

<div class="container mt-4" style="max-width: 850px;">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết Sách</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.Picture))
                    {
                        <img src="~/images/@Model.Picture" alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/book1.jpg';" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center rounded border" style="height: 250px;">
                            <span class="text-muted">Chưa có ảnh bìa</span>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h3 class="text-primary mb-3">@Model.Title</h3>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>Mã sách:</strong> <span class="badge bg-secondary">@Model.BookId</span></li>
                        <li class="list-group-item"><strong>Tác giả:</strong> @(Model.Author ?? "Chưa rõ")</li>
                        <li class="list-group-item"><strong>Năm xuất bản:</strong> @(Model.Release?.ToString() ?? "N/A")</li>
                        <li class="list-group-item">
                            <strong>Giá bán:</strong> 
                            <span class="text-danger fw-bold fs-5">
                                @(Model.Price.HasValue ? string.Format("{0:N0} đ", Model.Price.Value) : "Chưa có")
                            </span>
                        </li>
                        <li class="list-group-item"><strong>Loại sách:</strong> @(Model.Category != null ? Model.Category.CategoryName : "N/A")</li>
                        <li class="list-group-item"><strong>Nhà xuất bản:</strong> @(Model.Publisher != null ? Model.Publisher.PublisherName : "N/A")</li>
                    </ul>
                </div>
            </div>

            <div class="mt-3">
                <h5 class="fw-bold">Nội dung tóm tắt:</h5>
                <p class="text-secondary" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả cho cuốn sách này." : Model.Description)
                </p>
            </div>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-warning me-2">Chỉnh sửa</a>
                <a asp-action="Delete" asp-route-id="@Model.BookId" class="btn btn-danger">Xóa sách</a>
            </div>
        </div>
    </div>
</div>
