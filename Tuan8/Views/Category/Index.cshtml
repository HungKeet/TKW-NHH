@model IEnumerable<Tuan8.Models.DataModels.Category>

@{
    ViewData["Title"] = "Quản lý Loại sách";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-tags"></i> Danh sách Loại sách (Categories)</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm mới loại sách
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
            <thead class="table-dark">
                <tr class="text-center">
                    <th style="width: 120px;">Mã loại</th>
                    <th>Tên loại sách</th>
                    <th style="width: 160px;">Số lượng sách</th>
                    <th style="width: 180px;">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.CategoryId</td>
                            <td>
                                <strong>@item.CategoryName</strong>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@(item.Books?.Count ?? 0) cuốn</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Chưa có loại sách nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
