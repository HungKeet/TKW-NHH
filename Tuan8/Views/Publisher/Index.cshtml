@model IEnumerable<Tuan8.Models.DataModels.Publisher>

@{
    ViewData["Title"] = "Quản lý Nhà xuất bản";
}

<div class="container mt-4" style="max-width: 950px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-buildings"></i> Danh sách Nhà xuất bản (Publishers)</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm mới Nhà xuất bản
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
            <thead class="table-dark">
                <tr class="text-center">
                    <th style="width: 100px;">Mã NXB</th>
                    <th>Tên nhà xuất bản</th>
                    <th>Điện thoại</th>
                    <th>Địa chỉ</th>
                    <th style="width: 120px;">Số sách</th>
                    <th style="width: 180px;">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.PublisherId</td>
                            <td>
                                <strong>@item.PublisherName</strong>
                            </td>
                            <td>@(item.Phone ?? "N/A")</td>
                            <td>@(item.Address ?? "N/A")</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@(item.Books?.Count ?? 0) cuốn</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.PublisherId" class="btn btn-warning">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.PublisherId" class="btn btn-danger">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có nhà xuất bản nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
