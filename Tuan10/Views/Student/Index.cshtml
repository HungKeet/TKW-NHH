@model IEnumerable<Tuan10.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sinh viên</h2>
        <a asp-action="Create" class="btn btn-primary">Create Student</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Ảnh</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.Avatar))
                        {
                            <img src="@s.Avatar" alt="@s.Name" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="badge bg-secondary">No Avatar</span>
                        }
                    </td>
                    <td>@s.Name</td>
                    <td>@s.DateOfBorth.ToString("dd/MM/yyyy")</td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                            default:
                                str = "Chưa rõ";
                                break;
                        }
                    }
                    <td>@str</td>
                    <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                    <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@s.Address</td>
                    <td>@s.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>
