@model Student
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group row mb-2">
    <label asp-for="Name" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><input asp-for="Name" class="form-control" placeholder="Họ tên" /><span asp-validation-for="Name" class="text-danger"></span></div>
</div>
<div class="form-group row mb-2">
    <label asp-for="Email" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><input asp-for="Email" class="form-control" placeholder="Email" /><span asp-validation-for="Email" class="text-danger"></span></div>
</div>
<div class="form-group row mb-2">
    <label asp-for="Password" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><input asp-for="Password" class="form-control" placeholder="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
</div>
<div class="form-group row mb-2">
    <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><select asp-for="Branch" asp-items="ViewBag.AllBranches" class="branch-select"></select><span asp-validation-for="Branch" class="text-danger"></span></div>
</div>
<div class="form-group row mb-2">
    <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10 d-flex align-items-center"><input asp-for="IsRegular" class="form-check-input" /></div>
</div>
<div class="form-group row mb-2">
    <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><input asp-for="DateOfBorth" class="form-control" /><span asp-validation-for="DateOfBorth" class="text-danger"></span></div>
</div>
<div class="form-group row mb-2">
    <label class="col-sm-2 col-form-label">Gender</label>
    <div class="col-sm-10 d-flex gap-3 align-items-center">
        @foreach (Gender gender in ViewBag.AllGenders)
        {
            <label for="Gender@(gender)" class="form-check-label"><input type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" class="form-check-input" /> @gender</label>
        }
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
</div>
<div class="form-group row mb-2">
    <label asp-for="Address" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10"><textarea asp-for="Address" class="form-control" placeholder="Địa chỉ" rows="2"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
</div>
<div class="form-group row mb-3">
    <label for="avatar" class="col-sm-2 col-form-label">Avatar</label>
    <div class="col-sm-10"><input type="file" name="avatar" id="avatar" class="form-control" accept=".png,.jpg,.jpeg" /><div class="form-text">PNG hoặc JPG, tối đa 2 MB.</div><span class="text-danger">@Html.ValidationMessage("avatar")</span></div>
</div>
<div class="form-group row">
    <div class="col-sm-10"><button type="submit" class="btn btn-primary">Create</button></div>
</div>
