@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model MyWebApp.Models.Learner

<div class="ms-2 mx-2">
    <h1>Delete</h1>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <h4>Learner</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            FirstMidName
        </dt>
        <dd class="col-sm-10">
            @Model.FirstMidName
        </dd>
        <dt class="col-sm-2">
            LastName
        </dt>
        <dd class="col-sm-10">
            @Model.LastName
        </dd>
        <dt class="col-sm-2">
            Major
        </dt>
        <dd class="col-sm-10">
            @(Model.Major?.MajorName ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            EnrollmentDate
        </dt>
        <dd class="col-sm-10">
            @Model.EnrollmentDate
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="@Model.LearnerID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
