@model Student
@{
    ViewData["Title"] = "Create Student";
    string mode = ViewBag.LinkMode ?? "action";
}
@if (mode == "html")
{
    <partial name="_HtmlCreateForm" model="Model" />
}
else if (mode == "route")
{
    <form asp-route="StudentAdd" method="post" enctype="multipart/form-data" class="mt-3">
        <input type="hidden" name="mode" value="route" />
        <partial name="_StudentFields" model="Model" />
    </form>
}
else
{
    <form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3">
        <partial name="_StudentFields" model="Model" />
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
