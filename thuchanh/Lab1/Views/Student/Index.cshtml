@model IEnumerable<Student>
@{
    ViewData["Title"] = "Student List";
    string mode = ViewBag.LinkMode ?? "action";
}
@if (mode == "html")
{
    <a href="/Admin/Student/Add?mode=html" class="btn btn-primary mb-2">Create Student</a>
}
else if (mode == "route")
{
    <a asp-route="StudentAdd" asp-route-mode="route" class="btn btn-primary mb-2">Create Student</a>
}
else
{
    <a asp-action="Create" class="btn btn-primary mb-2">Create Student</a>
}
<div class="table-responsive">
    <table id="studentTable" class="table table-striped align-middle">
        <thead>
            <tr><th>Mã</th><th>Họ tên</th><th>Ngày sinh</th><th>Ngành</th><th>Giới tính</th><th>Hệ ĐT</th><th>Địa chỉ</th><th>Email</th><th>Ảnh</th></tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            string branch = s.Branch switch
            {
                Branch.IT => "CNTT",
                Branch.BE => "Kinh tế",
                Branch.CE => "Công trình",
                Branch.EE => "Điện - Điện tử",
                _ => ""
            };
            <tr>
                <td>@s.Id</td><td>@s.Name</td>
                <td class="text-nowrap">@s.DateOfBorth.ToString("M/d/yyyy h:mm:ss tt", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td>@branch</td><td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td><td>@s.Address</td><td>@s.Email</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.AvatarPath))
                    {
                        <img src="@s.AvatarPath" class="student-avatar" alt="Ảnh của @s.Name" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center py-4">Không tìm thấy sinh viên.</td></tr>
        }
        </tbody>
    </table>
</div>
