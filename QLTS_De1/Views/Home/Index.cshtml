@model IEnumerable<NguyenHuyHung_241230739.Models.TaiSan>

<div class="section-head">
    <h3 id="category-title">Nguyễn Huy Hùng</h3>
    <a asp-controller="TaiSan" asp-action="Create" style="font-weight: 600; font-size: 14px; color: #1d3f72;">+ Thêm Tài sản mới</a>
</div>

<div id="asset-container">
    <partial name="_DanhSachTaiSanPartial" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).on("click", ".nav-loai", function (e) {
            e.preventDefault();
            $(".menu li").removeClass("active");
            $(this).parent().addClass("active");

            var maLoai = $(this).data("maloai");
            var tenLoai = $(this).text();
            $("#category-title").text(tenLoai);

            $.ajax({
                url: "/Home/TaiSanTheoLoai",
                type: "GET",
                data: { maLoai: maLoai },
                success: function (data) {
                    $("#asset-container").html(data);
                },
                error: function () {
                    alert("Có lỗi khi tải dữ liệu!");
                }
            });
        });
    </script>
}
