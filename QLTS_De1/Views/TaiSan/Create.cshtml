@model NguyenHuyHung_241230739.Models.TaiSan

<div class="section-head">
    <h3>Nguyễn Huy Hùng</h3>
</div>

<div style="background: #fff; padding: 24px; border-radius: 8px; max-width: 650px; margin: 20px auto; box-shadow: 0 1px 4px rgba(0,0,0,.1);">
    <h2 style="color: #1d3f72; margin-bottom: 20px; font-size: 20px;">Thêm Tài sản mới</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #d9531e; margin-bottom: 15px;"></div>

        <div style="margin-bottom: 15px;">
            <label asp-for="MaLoai" style="display: block; font-weight: 600; margin-bottom: 6px; color: #1d3f72;"></label>
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="width: 100%; padding: 10px; border: 1px solid #c5d3d8; border-radius: 4px;"></select>
            <span asp-validation-for="MaLoai" style="color: #d9531e; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="TenTs" style="display: block; font-weight: 600; margin-bottom: 6px; color: #1d3f72;"></label>
            <input asp-for="TenTs" style="width: 100%; padding: 10px; border: 1px solid #c5d3d8; border-radius: 4px;" />
            <span asp-validation-for="TenTs" style="color: #d9531e; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="NguyenGia" style="display: block; font-weight: 600; margin-bottom: 6px; color: #1d3f72;"></label>
            <input asp-for="NguyenGia" type="number" step="any" style="width: 100%; padding: 10px; border: 1px solid #c5d3d8; border-radius: 4px;" />
            <span asp-validation-for="NguyenGia" style="color: #d9531e; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Anh" style="display: block; font-weight: 600; margin-bottom: 6px; color: #1d3f72;"></label>
            <input asp-for="Anh" placeholder="Ví dụ: Img_1.jpg" style="width: 100%; padding: 10px; border: 1px solid #c5d3d8; border-radius: 4px;" />
            <span asp-validation-for="Anh" style="color: #d9531e; font-size: 13px;"></span>
        </div>

        <div style="margin-top: 25px;">
            <button type="submit" class="btn-buy" style="font-size: 15px; padding: 10px 24px; font-weight: bold;">Create</button>
            <a asp-controller="Home" asp-action="Index" style="margin-left: 15px; color: #1d3f72; text-decoration: underline;">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
