<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NET CORE - @(ViewData["Title"] ?? ViewBag.Title)</title>
    <!-- Bootstrap CSS 3.3.7 -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding-bottom: 50px;
        }
        .navbar-inverse {
            border-radius: 0;
        }
        .thumbnail {
            min-height: 380px;
            text-align: center;
            padding: 15px;
            margin-bottom: 20px;
        }
        .thumbnail img {
            max-height: 250px;
            width: auto;
            object-fit: cover;
            border-radius: 4px;
        }
        .thumbnail .caption {
            padding: 9px;
            color: #333;
        }
        .carousel-inner > .item > img,
        .carousel-inner > .item > a > img {
            width: 100%;
            height: 320px;
            object-fit: cover;
        }
        .carousel-caption {
            right: 10%;
            left: 10%;
            bottom: 32px;
            padding-bottom: 0;
            text-align: center;
        }
        .carousel-caption p {
            margin-bottom: 0;
            font-size: 14px;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0,0,0,0.6);
            display: inline-block;
        }
        .carousel-caption .btn {
            background-color: #ffffff;
            color: #333333;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 3px 12px;
            font-size: 13px;
            margin-left: 10px;
            vertical-align: middle;
            text-shadow: none;
            box-shadow: 0 1px 1px rgba(0,0,0,0.05);
        }
        .carousel-caption .btn:hover {
            background-color: #e6e6e6;
            border-color: #adadad;
            color: #333333;
        }
        .carousel-indicators {
            bottom: 8px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#mainNavbar" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">DEMO LAB</a>
            </div>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="nav navbar-nav">
                    <li class="active"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    <li><a asp-controller="Home" asp-action="Index">Sản phẩm</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
