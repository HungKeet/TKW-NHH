@model IEnumerable<Tuan4.Models.Book>

@foreach (var item in Model)
{
    <div class="col-xs-12 col-sm-6 col-md-3 col-lg-3">
        <div class="thumbnail">
            <img src="@item.Image" alt="@item.Title" class="img-responsive" />
            <div class="caption">
                <h4 style="font-size: 16px; font-weight: bold; min-height: 40px;">@item.Title</h4>
                <p style="color: #c0392b; font-weight: 600;">
                    Price: @item.Price.ToString("N0") VNĐ
                </p>
            </div>
        </div>
    </div>
}
