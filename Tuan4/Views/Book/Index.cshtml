@model IEnumerable<Tuan4.Models.Book>
@{
    ViewData["Title"] = "Index";
}

<h2>Danh sách các cuốn sách</h2>

<form asp-action="Index" method="POST" class="form-inline" role="form" style="margin-bottom: 20px;">
    <div class="form-group">
        <select name="authorId" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn tác giả</option>
        </select>
        <select name="genreId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Chọn Thể loại</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a asp-action="Create" class="btn btn-danger">Thêm mới</a>
</form>

<hr />

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th style="width: 60px;">Id</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th style="width: 80px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td><strong>@book.Title</strong></td>
                <td>@book.AuthorId</td>
                <td>@book.GenreId</td>
                <td>@book.Price.ToString("N0")</td>
                <td>
                    <img src="@book.Image" alt="@book.Title" width="40" style="border: 1px solid #ccc; border-radius: 2px;" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
