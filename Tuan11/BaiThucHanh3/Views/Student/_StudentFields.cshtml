@model Student
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="form-group row mb-2">
    <label asp-for="Name" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="Name" class="form-control" placeholder="Nhập họ và tên (4 - 100 ký tự)" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="Email" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="Email" class="form-control" placeholder="Nhập email đuôi @@gmail.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="Password" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="Password" class="form-control" placeholder="Tối thiểu 8 ký tự (Chữ hoa, thường, số, ký tự đặc biệt)" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="Score" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="Score" type="number" step="0.1" class="form-control" placeholder="Nhập điểm số thực từ 0.0 đến 10.0" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <select asp-for="Branch" asp-items="ViewBag.AllBranches" class="form-select branch-select"></select>
        <span asp-validation-for="Branch" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label class="col-sm-2 col-form-label">Giới tính</label>
    <div class="col-sm-10 d-flex gap-3 align-items-center">
        @foreach (Gender gender in ViewBag.AllGenders)
        {
            <label for="Gender@(gender)" class="form-check-label">
                <input type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" class="form-check-input" /> @(gender == Gender.Male ? "Nam" : "Nữ")
            </label>
        }
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10 d-flex align-items-center">
        <div class="form-check">
            <input asp-for="IsRegular" class="form-check-input" id="isRegularCheck" />
            <label class="form-check-label" for="isRegularCheck">Hệ chính quy (True: chính quy, False: phi chính quy)</label>
        </div>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <input asp-for="DateOfBorth" class="form-control" type="date" />
        <span asp-validation-for="DateOfBorth" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-2">
    <label asp-for="Address" class="col-sm-2 col-form-label"></label>
    <div class="col-sm-10">
        <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ thường trú" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
</div>

<div class="form-group row mb-3">
    <label for="avatar" class="col-sm-2 col-form-label">Ảnh đại diện</label>
    <div class="col-sm-10">
        <input type="file" name="avatar" id="avatar" class="form-control" accept=".png,.jpg,.jpeg" />
        <div class="form-text">PNG hoặc JPG, tối đa 2 MB.</div>
        <span class="text-danger">@Html.ValidationMessage("avatar")</span>
    </div>
</div>

<div class="form-group row">
    <div class="col-sm-10 offset-sm-2">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</div>
