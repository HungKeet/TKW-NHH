@model IEnumerable<NguyenHuyHung_241230739.Models.TaiSan>

<div class="grid">
    @foreach (var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@item.Anh" alt="@item.TenTs" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@string.Format("{0:N0}", item.NguyenGia) tr</span>
                <a asp-controller="TaiSan" asp-action="Edit" asp-route-id="@item.MaTs" class="btn-buy" style="display:inline-block;">Sửa</a>
            </div>
        </div>
    }
</div>
