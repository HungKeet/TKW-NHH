@{
    ViewData["Title"] = "Trang chủ";
}


<div class="container-fluid mb-4 p-0">
    <div class="bg-primary text-white text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 250px;">
        <div class="d-flex align-items-center mb-3">
            <h1 class="display-4 fw-normal me-4">Microsoft Azure</h1>
       
            <h2 class="mx-2">🌐</h2>
            <h2 class="mx-2">⚡</h2>
            <h2 class="mx-2">🛢️</h2>
            <h2 class="mx-2">📊</h2>
        </div>
        <p class="fs-5">
            Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps.
            <button class="btn btn-light btn-sm ms-2 fw-bold text-primary">Learn More</button>
        </p>
    </div>
</div>


<div class="container mt-5">
